:"code","source":["import tensorflow as tf\n","from tensorflow.keras.callbacks import ModelCheckpoint\n","\n","# 1. Ensure your dataset path is correct and accessible\n","# Using the path you provided: '/content/drive/MyDrive/kisan_mitra_data/Rice_Leaf_AUG'\n","\n","# 2. Re-initialize the training with Verbose Output\n","# verbose=1 is critical: it forces the progress bar to show up.\n","history = model.fit(\n","    train_gen,\n","    epochs=15, # Increased slightly to ensure convergence\n","    validation_data=val_gen,\n","    verbose=1  # This will print the epoch-by-epoch status\n",")\n","\n","# 3. Save the final model explicitly\n","model.save('/content/drive/MyDrive/kisan_mitra_data/crop_disease_model_retrain.h5')\n","print(\"Training complete. Brain saved to Google Drive.\")"],"metadata":{"id":"o_ylZBLOCB54","executionInfo":{"status":"ok","timestamp":1783537397656,"user_tz":-330,"elapsed":1334149,"user":{"displayName":"","userId":""}},"outputId":"44b9555f-cde3-473b-c054-bb6c6e8fd401","colab":{"base_uri":"https://localhost:8080/"}},"execution_count":9,"outputs":[{"output_type":"stream","name":"stdout","text":["Epoch 1/15\n","\u001b[1m96/96\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m88s\u001b[0m 921ms/step - accuracy: 0.8868 - loss: 0.3308 - val_accuracy: 0.7287 - val_loss: 0.9171\n","Epoch 2/15\n","\u001b[1m96/96\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m86s\u001b[0m 895ms/step - accuracy: 0.8862 - loss: 0.3240 - val_accuracy: 0.7077 - val_loss: 0.9407\n","Epoch 3/15\n","\u001b[1m96/96\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m85s\u001b[0m 891ms/step - accuracy: 0.8878 - loss: 0.3063 - val_accuracy: 0.7235 - val_loss: 0.8551\n","Epoch 4/15\n","\u001b[1m96/96\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m84s\u001b[0m 878ms/step - accuracy: 0.8963 - loss: 0.3023 - val_accuracy: 0.6474 - val_loss: 1.1863\n","Epoch 5/15\n","\u001b[1