ame":"","userId":""}},"outputId":"cb5ca943-ca7c-4eb0-ba6b-87f789cc4a3b","colab":{"base_uri":"https://localhost:8080/","height":722}},"execution_count":10,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x400 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 800x400 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Final Training Accuracy: 0.9413\n","Final Training Loss: 0.1832\n","Final Validation Accuracy: 0.7523\n","Final Validation Loss: 0.8956\n"]}]},{"cell_type":"code","source":["from tensorflow.keras.callbacks import EarlyStopping, ModelCheckpoint\n","\n","# 1. Enhanced Data Augmentation (Prevents Memorization)\n","datagen = ImageDataGenerator(\n","    rescale=1./255,\n","    validation_split=0.2,\n","    rotation_range=45,          # Increased from 20\n","    width_shift_range=0.3,      # Increased to create variety\n","    height_shift_range=0.3,     # Increased to create variety\n","    shear_range=0.3,            # Increased\n","    zoom_range=0.3,             # Increased\n","    horizontal_flip=True,\n","    brightness_range=[0.8, 1.2] # Simulates different times of day\n",")\n","\n","# 2. Add Early Stopping (Prevents Overfitting)\n","# This stops training when validation loss stops improving for 3 consecutive epochs\n","early_stop = EarlyStopping(monitor='val_loss', patience=3, restore_best_weights=True)\n","\n","# 3. Model Architecture Upgrade\n","# Increasing dropout significantly to force feature learning\n","base_model = MobileNetV2(weights='imagenet', include_top=False, input_shape=(224, 224, 3))\n","base_model.trainable = False\n","\n","x = base_model.output\n","x = GlobalAveragePooling2D()(x)\n","x = Dense(256, activation='relu')(x) # Increased capacity\n","x = Dropout(0.5)(x)                  # Aggressive dropout to stop overfitting\n","predictions = Dense(train_gen.num_classes, activation='softmax')(x)\n","\n","model = Model(inputs=base_model.input, outputs=predictions)\n","\n","model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=0.0001),\n","              loss='categorical_crossentropy',\n","              metrics=['accuracy'])\n","\n","# 4. Train with Callbacks\n","history = model.fit(\n","    train_gen,\n","    epochs=20,\n","    validation_data=val_gen,\n","    callbacks=[early_stop]\n",")"],"metadata":{"id":"N81_OvG1Ils_","executionInfo":{"status":"ok","timestamp":1783538458999,"user_tz":-330,"elapsed":695366,"user":{"displayName":"","userId":""}},"outputId":"89cc24e1-db11-4ad3-efbb-ec9031e19ee3","colab":{"base_uri":"https://localhost:8080/"}},"execution_count":11,"outputs":[{"output_type":"stream","name":"stdout","text":["Epoch 1/20\n","\u001b[1m96/96\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m108s\u001b[0m 1s/step - accuracy: 0.3262 - loss: 1.7789 - val_accuracy: 0.4377 - val_loss: 1.4079\n","Epoch 2/20\n","\u001b[1m96/96\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m81s\u001b[0m 852ms/step - accuracy: 0.5176 - loss: 1.2849 - val_accuracy: 0.4954 - val_loss: 1.2843\n","Epoch 3/20\n","\u001b[1m96/96\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m84s\u001b[0m 863ms/step - accuracy: 0.5812 - loss: 1.1134 - val_accuracy: 0.5033 - val_loss: 1.3044\n","Epoch 4/20\n","\u001b[1m96/96\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m82s\u001b[0m 859ms/step - accuracy: 0.6155 - loss: 1.0182 - val_accuracy: 0.5426 - val_loss: 1.1839\n","Epoch 5/20\n","\u001b[1m96/96\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m83s\u001b[0m 872ms/step - accuracy: 0.6455 - loss: 0.9450 - val_accuracy: 0.5898 - val_loss: 1.1078\n","Epoch 6/20\n","\u001b[1m96/96\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m88s\u001b[0m 919ms/step - accuracy: 0.6729 - loss: 0.8981 - val_accuracy: 0.5767 - val_loss: 1.1261\n","Epoch 7/20\n","\u001b[1m96/96\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m83s\u001b[0m 869ms/step - accuracy: 0.6973 - loss: 0.8434 - val_accuracy: 0.5819 - val_loss: 1.1210\n","Epoch 8/20\n","\u001b[1m96/96\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m83s\u001b[0m 872ms/step - accuracy: 0.7078 - loss: 0.7972 - val_accuracy: 0.5675 - val_loss: 1.1682\n"]}]},{"cell_type":"code","source":["# Access the metrics from the history object\n","acc = history.history['accuracy']\n","val_acc = history.history['val_accuracy']\n","loss = history.history['loss']\n","val_loss = history.history['val_loss']\n","\n","# Print the values from the final epoch\n","print(f\"Final Training Accuracy: {acc[-1]:.4f}\")\n","print(f\"Final Training Loss: {loss[-1]:.4f}\")\n","print(f\"Final Validation Accuracy: {val_acc[-1]:.4f}\")\n","print(f\"Final Validation Loss: {val_loss[-1]:.4f}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"kbKOEg0zMrVM","executionInfo":{"status":"ok","timestamp":1783538830846,"user_tz":-330,"elapsed":38,"user":{"displayName":"","userId":""}},"outputId":"914f98da-002d-4c72-bc57-e787c2a742fe"},"execution_count":12,"outputs":[{"output_type":"stream","name":"stdout","text":["Final Training Accuracy: 0.7078\n","Final Training Loss: 0.7972\n","Final Validation Accuracy: 0.5675\n","Final Validation Loss: 1.1682\n"]}]},{"cell_type":"code","source":["import matplotlib.pyplot as plt\n","\n","epochs = range(1, len(acc) + 1)\n","\n","# Accuracy Plot\n","plt.figure(figsize=(10, 4))\n","plt.subplot(1, 2, 1)\n","plt.plot(epochs, acc, label='Training Accuracy')\n","plt.plot(epochs, val_acc, label='Validation Accuracy')\n","plt.title('Accuracy: Training vs. Validation')\n","plt.legend()\n","\n","# Loss Plot\n","plt.subplot(1, 2, 2)\n","plt.plot(epochs, loss, label='Training Loss')\n","plt.plot(epochs, val_loss, label='Validation Loss')\n","plt.title('Loss: Training vs. Validation')\n","plt.legend()\n","plt.show()"],"metadata":{"id":"Q4ywr3deMyOR","executionInfo":{"status":"ok","timestamp":1783538857931,"user_tz":-330,"elapsed":913,"user":{"displayName":"","userId":""}},"outputId":"0ee72d50-d959-440b-f07e-1db4eccdf6cd","colab":{"base_uri":"https://localhost:8080/","height":212}},"execution_count":13,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x400 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["from tensorflow.keras import regularizers\n","\n","# 1. Update the Model Architecture\n","base_model = MobileNetV2(weights='imagenet', include_top=False, input_shape=(224, 224, 3))\n","base_model.trainable = False\n","\n","x = base_model.output\n","x = GlobalAveragePooling2D()(x)\n","\n","# Add L2 Regularization (weight decay) to prevent overfitting\n","x = Dense(256, activation='relu', kernel_regularizer=regularizers.l2(0.01))(x)\n","\n","# Increase Dropout to 0.5 to force the model to rely on multiple pathways\n","x = Dropout(0.5)(x)\n","\n","predictions = Dense(train_gen.num_classes, activation='softmax')(x)\n","model = Model(inputs=base_model.input, outputs=predictions)\n","\n","# 2. Compile with a lower learning rate\n","model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=0.0001),\n","              loss='categorical_crossentropy',\n","              metrics=['accuracy'])\n","# 3. Trigger the Training Loop\n","history = model.fit(\n","    train_gen,\n","    validation_data=val_gen,\n","    epochs=15,  # Start with 15 epochs\n","    steps_per_epoch=train_gen.samples // train_gen.batch_size,\n","    validation_steps=val_gen.samples // val_gen.batch_size\n",")\n"],"metadata":{"id":"5i7L5Sd7NiPF","executionInfo":{"status":"ok","timestamp":1783540656521,"user_tz":-330,"elapsed":860869,"user":{"displayName":"","userId":""}},"outputId":"5c903976-b780-4cc1-fad6-c9565643a799","colab":{"base_uri":"https://localhost:8080/"}},"execution_count":18,"outputs":[{"output_type":"stream","name":"